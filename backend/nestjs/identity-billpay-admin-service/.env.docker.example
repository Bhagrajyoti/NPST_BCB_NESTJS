# Copy to .env.docker on the server (that file is gitignored).
# cp .env.docker.example .env.docker

# --- App (Docker) ---
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# App routes stay at /api/v1 — gateway adds /identity in front externally.
API_GLOBAL_PREFIX=api/v1
GATEWAY_PATH_PREFIX=identity
APP_PUBLIC_BASE_URL=http://103.209.145.243:9101/identity

# --- MySQL (docker-compose mysql-db service, database db1) ---
DB_HOST=mysql-db
DB_PORT=3306
DB_USERNAME=bcb_user
DB_PASSWORD=bcb_pass
DB_DATABASE=db1
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- Keycloak (Bharat Banking) ---
KEYCLOAK_AUTH_SERVER_URL=http://103.209.145.243:8201
KEYCLOAK_ISSUER=http://103.209.145.243:8201/realms/bharat-banking
KEYCLOAK_REALM=bharat-banking
KEYCLOAK_CLIENT_ID=admin-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_TOKEN_VALIDATION=offline
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# --- OTP ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
