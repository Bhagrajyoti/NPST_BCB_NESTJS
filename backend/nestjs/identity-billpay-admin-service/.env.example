# --- App ---
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api/v1

# --- MySQL (docker-compose mysql service) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=bcb_user
DB_PASSWORD=bcb_pass
DB_DATABASE=identity_billpay_admin
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- Keycloak (Bharat Banking) ---
KEYCLOAK_AUTH_SERVER_URL=http://103.209.145.243:8201
KEYCLOAK_ISSUER=http://103.209.145.243:8201/realms/bharat-banking
KEYCLOAK_REALM=bharat-banking
KEYCLOAK_CLIENT_ID=admin-web
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_REALM_PUBLIC_KEY=
KEYCLOAK_TOKEN_VALIDATION=offline
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# --- OTP ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
