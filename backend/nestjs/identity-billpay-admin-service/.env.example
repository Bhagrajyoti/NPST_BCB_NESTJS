# --- App ---
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api/v1

# --- Postgres (single instance, three schemas) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=identity_billpay_admin
DB_SCHEMA_IDENTITY=identity
DB_SCHEMA_BILLPAY=billpay
DB_SCHEMA_ADMIN=admin
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- Keycloak ---
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=corporate-banking
KEYCLOAK_CLIENT_ID=identity-billpay-admin-service
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_AUDIT_EXCHANGE=audit.events

# --- Downstream services ---
CBS_BASE_URL=http://localhost:9001
NOTIFICATION_BASE_URL=http://localhost:9002
CHECKSUM_SECRET=change-me

# --- BBPS ---
BBPS_BASE_URL=http://localhost:9003
BBPS_API_KEY=change-me

# --- OTP ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
