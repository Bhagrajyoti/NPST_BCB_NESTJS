# --- App ---
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api/v1

# --- Mock auth (local/offline testing only — see mock-testing-guide.md) ---
# true: /auth/login and every @Auth() route are served by the fixed fake users in
# src/modules/auth/keycloak/mock-users.const.ts instead of the real Keycloak server.
# false/unset (default): normal behavior, real Keycloak required. NEVER set true outside local dev.
AUTH_MOCK_MODE=false

# --- MySQL (docker-compose mysql-db service, database db1) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=bcb_user
DB_PASSWORD=bcb_pass
DB_DATABASE=db1
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- Keycloak (Bharat Banking) ---
# NOTE: the token issuer (`iss`) is always authServerUrl + /realms/REALM — it must exactly
# match the Frontend URL configured on the Keycloak realm. Signing keys are fetched live from
# Keycloak's JWKS endpoint (no static public key here) so key rotation never breaks validation.
KEYCLOAK_AUTH_SERVER_URL=http://103.209.145.243:8201
KEYCLOAK_REALM=bharat-banking
KEYCLOAK_CLIENT_ID=admin-web
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_TOKEN_VALIDATION=offline
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# --- OTP ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
